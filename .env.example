# Copy this file to .env or set these variables in your shell before running
# scripts that authenticate to Google Earth Engine.

# Required unless the JSON key contains client_email and is the only non-example
# JSON file in 06_Google_application_credentials/.
EII_GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com

# Recommended. Keep the real JSON key out of version control.
EII_GEE_KEY_PATH=D:\path\to\service-account-key.json
